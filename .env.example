# findmoviessubtitles.xyz Environment Variables Example
# Copy this file to .env.local and fill in your actual API keys.

# SubDL API Key - Obtain from https://subdl.com/panel/api (Free account allows 2,000 req/day)
SUBDL_API_KEY=your_subdl_api_key_here

# SubSource API Key - Obtain from https://subsource.net (My Profile dashboard)
SUBSOURCE_API_KEY=your_subsource_api_key_here

# TMDB API Key - Obtain from https://www.themoviedb.org/documentation/api
TMDB_API_KEY=your_tmdb_api_key_here

# Next Public Site URL (Production URL)
NEXT_PUBLIC_SITE_URL=https://findmoviessubtitles.xyz

# OpenSubtitles.com API Credentials - Obtain from https://opensubtitles.com/api/v1/
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
OPENSUBTITLES_USERNAME=your_opensubtitles_username_here
OPENSUBTITLES_PASSWORD=your_opensubtitles_password_here
OPENSUBTITLES_USER_AGENT=FindMoviesSubtitles v1.0

